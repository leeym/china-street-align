{
  "manifest_version": 3,
  "name": "Google Maps China Street Align",
  "version": "0.7.1",
  "description": "Inside China, aligns WGS-84 satellite imagery with the GCJ-02 map layers — shift the streets onto the photo, or the photo under the streets.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.com.hk/*",
    "https://maps.google.com/*",
    "https://*.google.com/*",
    "https://*.google.com.hk/*",
    "https://mt0.google.com/*",
    "https://mt1.google.com/*",
    "https://mt2.google.com/*",
    "https://mt3.google.com/*",
    "https://*.googleapis.com/*",
    "https://khms0.google.com/*",
    "https://khms1.google.com/*",
    "https://khms2.google.com/*",
    "https://khms3.google.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "China Street Align · idle",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://www.google.com/maps/*",
        "https://www.google.com.hk/maps*",
        "https://www.google.com.hk/maps/*",
        "https://maps.google.com/*"
      ],
      "js": ["aligner-lib.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
