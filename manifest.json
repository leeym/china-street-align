{
  "manifest_version": 3,
  "name": "China Street Align for Google Maps",
  "version": "0.8.14",
  "description": "Inside China, aligns GCJ-02 street labels with WGS-84 satellite imagery on Google Maps.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.com.hk/*",
    "https://maps.google.com/*",
    "https://*.google.com/*",
    "https://*.google.com.hk/*",
    "https://mt0.google.com/*",
    "https://mt1.google.com/*",
    "https://mt2.google.com/*",
    "https://mt3.google.com/*",
    "https://*.googleapis.com/*",
    "https://khms0.google.com/*",
    "https://khms1.google.com/*",
    "https://khms2.google.com/*",
    "https://khms3.google.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "China Street Align for Google Maps",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://www.google.com/maps/*",
        "https://www.google.com.hk/maps*",
        "https://www.google.com.hk/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "page-basemap.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://www.google.com/maps/*",
        "https://www.google.com.hk/maps*",
        "https://www.google.com.hk/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "aligner-lib.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/place-pin.png",
        "assets/place-pin-hdpi.png"
      ],
      "matches": [
        "https://www.google.com/*",
        "https://www.google.com.hk/*",
        "https://maps.google.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
